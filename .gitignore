# Local development & IDEs
.idea/
.vscode/
.history/
*.swp
*.bak
.DS_Store
Thumbs.db

# OpenSpec — local tooling only, not part of the published project
openspec/

# Agent tooling — local only, not part of the published project
.claude/
.gemini/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
errored.tfstate
crash.log
*.tfvars
*.tfvars.json
# Track the per-environment tfvars — they hold only non-secret config
# (name, region, environment, state_bucket). Secrets go via TF_VAR_* in CI.
!**/environments/*/terraform.tfvars
override.tf
override.tf.json
_override.tf
_override.tf.json
.terraformrc
terraform.rc

# Manter o lock file é boa prática
!.terraform.lock.hcl
# Manter arquivos de CI e Git
!.gitignore
!.github/